// session/kv_raw.baga — примитивите към rocksbaga без транзакционен overlay.
//
// Отделен модул, защото kv_tx.baga трябва да изсипва буфера през същите
// буферни операции (MSET/DEL), без пак да минават през overlay-а — иначе
// двете модули се викат взаимно. Резите държат всяка команда под 64-те
// аргумента на rocksbaga.

import "db.baga"
import "drockb/drockb.baga"
import "std/bytes/bytes.baga"
import "std/str/str.baga"

// ── суров KV достъп (без транзакция) ─────────────────────────────────────

fn kv_raw_get(db: OrmDb, key: str) -> str !Net !IO {
    return drock_get_str(db.kv, key)?
}

fn kv_raw_put(db: OrmDb, key: str, val: str) -> i64 !Net !IO {
    let r = drock_put_str(db.kv, key, val)?
    return r.ok
}

fn kv_raw_del(db: OrmDb, key: str) -> i64 !Net !IO {
    let r = drock_delete(db.kv, bytes_of_str(key))?
    return r.ok
}

fn kv_raw_incr(db: OrmDb, key: str) -> i64 !Net !IO {
    let r = drock_incr(db.kv, bytes_of_str(key))?
    if r.ok == 0 {
        return 0 - 1
    }
    return r.n
}

// rocksbaga приема най-много 64 аргумента на команда (63 ключа + "MGET").
// Затова четем на парчета — иначе сървърът затваря връзката и всичко след
// това върви с "connection lost" / "database unavailable".
fn KV_CMD_MAX_ARGS() -> i64 { return 64 }

fn kv_raw_mget(db: OrmDb, keys: Vec<str>) -> Vec<str> !Net !IO {
    let out: Vec<str> = vec_new()
    if vec_len(keys) == 0 {
        return out
    }
    let chunk = KV_CMD_MAX_ARGS() - 4
    let mut off: i64 = 0
    while off < vec_len(keys) {
        let bk: Vec<bytes> = vec_new()
        let mut i = off
        let end = off + chunk
        while i < vec_len(keys) && i < end {
            vec_push(bk, bytes_of_str(vec_get(keys, i)))
            i = i + 1
        }
        let r = drock_mget(db.kv, bk)?
        if r.ok == 0 {
            return out
        }
        let mut j: i64 = 0
        while j < vec_len(r.vals) {
            vec_push(out, str_of_bytes(vec_get(r.vals, j)))
            j = j + 1
        }
        off = off + chunk
    }
    return out
}

// MSET носи по 2 аргумента на двойка — пак под 64-аргументния таван.
fn kv_raw_mset(db: OrmDb, keys: Vec<str>, vals: Vec<str>) -> i64 !Net !IO {
    if vec_len(keys) == 0 || vec_len(keys) != vec_len(vals) {
        return 0
    }
    let chunk = (KV_CMD_MAX_ARGS() - 4) / 2
    let mut off: i64 = 0
    while off < vec_len(keys) {
        let bk: Vec<bytes> = vec_new()
        let bv: Vec<bytes> = vec_new()
        let mut i = off
        let end = off + chunk
        while i < vec_len(keys) && i < end {
            vec_push(bk, bytes_of_str(vec_get(keys, i)))
            vec_push(bv, bytes_of_str(vec_get(vals, i)))
            i = i + 1
        }
        let r = drock_mset(db.kv, bk, bv)?
        if r.ok == 0 {
            return 0
        }
        off = off + chunk
    }
    return 1
}

// DEL носи по един аргумент на ключ — същият 64-аргументен ряз.
fn kv_raw_del_many(db: OrmDb, keys: Vec<str>) -> i64 !Net !IO {
    if vec_len(keys) == 0 {
        return 1
    }
    let chunk = KV_CMD_MAX_ARGS() - 4
    let mut off: i64 = 0
    while off < vec_len(keys) {
        let bk: Vec<bytes> = vec_new()
        let mut i = off
        let end = off + chunk
        while i < vec_len(keys) && i < end {
            vec_push(bk, bytes_of_str(vec_get(keys, i)))
            i = i + 1
        }
        let r = drock_del(db.kv, bk)?
        if r.ok == 0 {
            return 0
        }
        off = off + chunk
    }
    return 1
}
