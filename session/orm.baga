// orm.baga — table session + CRUD over pgbaga.
// Baga-shaped ORM: table name + column lists, parameterized $1 binds by
// default, rows as dynamic cells (no codegen structs). Structs are by-value —
// always rebind:  db = orm_db_q(r) / orm_db_exec(r).

import "pgbaga/pg.baga"
import "boilabaga/adapter.baga"
import "drockb/drockb.baga"
import "db.baga"
import "result.baga"
import "kv.baga"
import "kv_write.baga"
import "../sql/sql.baga"
import "std/str/str.baga"
import "std/os/os.baga"

// Raw SQL execute (DDL/DML). Prefer typed helpers for user data.
fn orm_exec(db: OrmDb, sql: str) -> OrmExec !IO !Net {
    if orm_is_drock(db) == 1 {
        return kv_exec_err(db, concat("drock backend не изпълнява DDL/DML през SQL: ", sql))
    }
    let r = pg_query(db.conn, sql)?
    return orm_exec_from(r)
}

// Raw SQL query (SELECT). На drock backend минава през kv_query_sql, който
// покрива само пинга и MAX(id)/COUNT(*).
fn orm_query(db: OrmDb, sql: str) -> OrmQuery !IO !Net {
    if orm_is_drock(db) == 1 {
        return kv_query_sql(db, sql)?
    }
    let r = pg_query(db.conn, sql)?
    return orm_query_from(r)
}

// COUNT(*) helper from a full SQL that returns one row / col "count" or first cell.
fn orm_count_sql(db: OrmDb, sql: str) -> OrmCount !IO !Net {
    if orm_is_drock(db) == 1 {
        return kv_count_sql(db, sql)?
    }
    let q = orm_query(db, sql)?
    if orm_ok_q(q) == 0 {
        return OrmCErr(OrmCountFail { err: orm_err_q(q), db: orm_db_q(q) })
    }
    if orm_nrows(q) < 1 {
        return OrmCOk(OrmCountOk { count: 0, db: orm_db_q(q) })
    }
    return OrmCOk(OrmCountOk {
        count: pg_cell_i64(orm_result(q), 0, 0),
        db: orm_db_q(q)
    })
}

// ---------- transactions ----------

fn orm_begin(db: OrmDb) -> OrmExec !IO !Net {
    return orm_exec(db, "BEGIN")?
}

fn orm_commit(db: OrmDb) -> OrmExec !IO !Net {
    return orm_exec(db, "COMMIT")?
}

fn orm_rollback(db: OrmDb) -> OrmExec !IO !Net {
    return orm_exec(db, "ROLLBACK")?
}

// ---------- table API ----------

// SELECT * FROM table
fn orm_all(db: OrmDb, table: str) -> OrmQuery !IO !Net {
    if orm_is_drock(db) == 1 {
        return kv_all_star(db, table)?
    }
    return orm_query(db, sql_select_all(table))?
}

// SELECT * FROM table ORDER BY col [DESC] LIMIT n OFFSET o
fn orm_all_page(db: OrmDb, table: str, order_col: str, desc: i64, limit: i64, offset: i64) -> OrmQuery !IO !Net {
    let sql = sql_page(sql_order(sql_select_all(table), order_col, desc), limit, offset)
    return orm_query(db, sql)?
}

// Raw parameterized query (Extended Query). Prefer over string concat for values.
//
// drock guard-ът не е козметика: orm_query_from строи OrmDb от PgResult с
// backend=PG и мъртъв kv, така че суров SQL върху drock би подменил живата
// връзка на работника и всяка следваща заявка би дала 503.
fn orm_query_params(db: OrmDb, sql: str, vals: Vec<str>, nulls: Vec<i64>) -> OrmQuery !IO !Net {
    if orm_is_drock(db) == 1 {
        return kv_query_err(db, concat("drock backend: моделът ползва суров SQL (трябва kv_select_*): ", sql))
    }

    let r = pg_query_params(db.conn, sql, vals, nulls)?
    return orm_query_from(r)
}

fn orm_query_params_str(db: OrmDb, sql: str, vals: Vec<str>) -> OrmQuery !IO !Net {
    if orm_is_drock(db) == 1 {
        return kv_query_err(db, concat("drock backend: моделът ползва суров SQL (трябва kv_select_*): ", sql))
    }

    let r = pg_query_params_str(db.conn, sql, vals)?
    return orm_query_from(r)
}

fn orm_exec_params(db: OrmDb, sql: str, vals: Vec<str>, nulls: Vec<i64>) -> OrmExec !IO !Net {
    if orm_is_drock(db) == 1 {
        return kv_exec_err(db, concat("drock backend: моделът ползва суров SQL (трябва kv_*): ", sql))
    }

    let r = pg_query_params(db.conn, sql, vals, nulls)?
    return orm_exec_from(r)
}

fn orm_exec_params_str(db: OrmDb, sql: str, vals: Vec<str>) -> OrmExec !IO !Net {
    if orm_is_drock(db) == 1 {
        return kv_exec_err(db, concat("drock backend: моделът ползва суров SQL (трябва kv_*): ", sql))
    }

    let r = pg_query_params_str(db.conn, sql, vals)?
    return orm_exec_from(r)
}

// Find one row by pk (parameterized)
fn orm_find_i64(db: OrmDb, table: str, pk: str, id: i64) -> OrmQuery !IO !Net {
    if orm_is_drock(db) == 1 {
        return kv_where_star(db, table, pk, int_to_str(id))?
    }
    let sql = sql_limit(sql_select_where_eq_p(table, pk), 1)
    let vals = vec_new()
    let nulls = vec_new()
    pg_param_i64(vals, nulls, id)
    return orm_query_params(db, sql, vals, nulls)?
}

fn orm_find_str(db: OrmDb, table: str, pk: str, id: str) -> OrmQuery !IO !Net {
    if orm_is_drock(db) == 1 {
        return kv_where_star(db, table, pk, id)?
    }
    let sql = sql_limit(sql_select_where_eq_p(table, pk), 1)
    let vals = vec_new()
    vec_push(vals, id)
    return orm_query_params_str(db, sql, vals)?
}

// Legacy: pre-built SQL literal (prefer orm_find_*).
fn orm_find_lit(db: OrmDb, table: str, pk: str, id_lit: str) -> OrmQuery !IO !Net {
    let sql = sql_limit(sql_select_where_eq(table, pk, id_lit), 1)
    return orm_query(db, sql)?
}

// WHERE col = $1 (parameterized)
fn orm_where_eq_str(db: OrmDb, table: str, col: str, val: str) -> OrmQuery !IO !Net {
    if orm_is_drock(db) == 1 {
        return kv_where_star(db, table, col, val)?
    }
    let sql = sql_select_where_eq_p(table, col)
    let vals = vec_new()
    vec_push(vals, val)
    return orm_query_params_str(db, sql, vals)?
}

fn orm_where_eq_i64(db: OrmDb, table: str, col: str, val: i64) -> OrmQuery !IO !Net {
    if orm_is_drock(db) == 1 {
        return kv_where_star(db, table, col, int_to_str(val))?
    }
    let sql = sql_select_where_eq_p(table, col)
    let vals = vec_new()
    let nulls = vec_new()
    pg_param_i64(vals, nulls, val)
    return orm_query_params(db, sql, vals, nulls)?
}

// WHERE + ORDER + LIMIT/OFFSET (value still bound as $1)
fn orm_where_eq_str_page(db: OrmDb, table: str, col: str, val: str, order_col: str, desc: i64, limit: i64, offset: i64) -> OrmQuery !IO !Net {
    let sql = sql_page(sql_order(sql_select_where_eq_p(table, col), order_col, desc), limit, offset)
    let vals = vec_new()
    vec_push(vals, val)
    return orm_query_params_str(db, sql, vals)?
}

fn orm_where_eq_i64_page(db: OrmDb, table: str, col: str, val: i64, order_col: str, desc: i64, limit: i64, offset: i64) -> OrmQuery !IO !Net {
    let sql = sql_page(sql_order(sql_select_where_eq_p(table, col), order_col, desc), limit, offset)
    let vals = vec_new()
    let nulls = vec_new()
    pg_param_i64(vals, nulls, val)
    return orm_query_params(db, sql, vals, nulls)?
}

// Legacy literal path
fn orm_where_eq_lit(db: OrmDb, table: str, col: str, lit: str) -> OrmQuery !IO !Net {
    return orm_query(db, sql_select_where_eq(table, col, lit))?
}

// INSERT … VALUES ($1,$2,…)
fn orm_insert_strs(db: OrmDb, table: str, cols: Vec<str>, vals: Vec<str>) -> OrmExec !IO !Net {
    if orm_is_drock(db) == 1 {
        let nulls: Vec<i64> = vec_new()
        let mut i: i64 = 0
        while i < vec_len(vals) {
            vec_push(nulls, 0)
            i = i + 1
        }
        return kv_insert_exec(db, table, cols, vals, nulls)?
    }
    return orm_exec_params_str(db, sql_insert_p(table, cols), vals)?
}

// INSERT … RETURNING * — one round-trip; row is in the query result.
fn orm_insert_returning_strs(db: OrmDb, table: str, cols: Vec<str>, vals: Vec<str>) -> OrmQuery !IO !Net {
    if orm_is_drock(db) == 1 {
        let nulls: Vec<i64> = vec_new()
        let mut i: i64 = 0
        while i < vec_len(vals) {
            vec_push(nulls, 0)
            i = i + 1
        }
        return kv_insert(db, table, cols, vals, nulls)?
    }
    return orm_query_params_str(db, sql_insert_returning_p(table, cols), vals)?
}

// INSERT with per-column NULL flags: nulls[i]==1 binds SQL NULL for column i.
// All three vectors must have equal length (fail-loud, not silent truncation).
fn orm_insert_full(db: OrmDb, table: str, cols: Vec<str>, vals: Vec<str>, nulls: Vec<i64>) -> OrmExec !IO !Net {
    if orm_is_drock(db) == 1 {
        return kv_insert_exec(db, table, cols, vals, nulls)?
    }
    if vec_len(cols) != vec_len(vals) || vec_len(cols) != vec_len(nulls) {
        return OrmEErr(OrmExecFail { err: "orm_insert_full: cols/vals/nulls length mismatch", tag: "", db: db })
    }
    return orm_exec_params(db, sql_insert_p(table, cols), vals, nulls)?
}

// INSERT … RETURNING * with per-column NULL flags (same rules as above).
fn orm_insert_returning_full(db: OrmDb, table: str, cols: Vec<str>, vals: Vec<str>, nulls: Vec<i64>) -> OrmQuery !IO !Net {
    if orm_is_drock(db) == 1 {
        return kv_insert(db, table, cols, vals, nulls)?
    }
    if vec_len(cols) != vec_len(vals) || vec_len(cols) != vec_len(nulls) {
        return OrmQErr(OrmQueryFail { err: "orm_insert_returning_full: cols/vals/nulls length mismatch", tag: "", db: db })
    }
    return orm_query_params(db, sql_insert_returning_p(table, cols), vals, nulls)?
}

// Legacy: pre-quoted lits via Simple Query
fn orm_insert_lits(db: OrmDb, table: str, cols: Vec<str>, lits: Vec<str>) -> OrmExec !IO !Net {
    return orm_exec(db, sql_insert(table, cols, lits))?
}

fn orm_insert_returning_lits(db: OrmDb, table: str, cols: Vec<str>, lits: Vec<str>) -> OrmQuery !IO !Net {
    return orm_query(db, sql_insert_returning(table, cols, lits))?
}

// UPDATE SET cols = $1..$n WHERE wcol = $n+1
fn orm_update_str(db: OrmDb, table: str, set_cols: Vec<str>, set_vals: Vec<str>, where_col: str, where_val: str) -> OrmExec !IO !Net {
    let sql = sql_update_eq_p(table, set_cols, where_col)
    let vals = vec_new()
    for i in 0..vec_len(set_vals) {
        vec_push(vals, vec_get(set_vals, i))
    }
    vec_push(vals, where_val)
    return orm_exec_params_str(db, sql, vals)?
}

fn orm_update_by_id(db: OrmDb, table: str, id: i64, set_cols: Vec<str>, set_vals: Vec<str>) -> OrmExec !IO !Net {
    if orm_is_drock(db) == 1 {
        return kv_update_strs(db, table, id, set_cols, set_vals)?
    }
    let sql = sql_update_eq_p(table, set_cols, "id")
    let vals = vec_new()
    let nulls = vec_new()
    for i in 0..vec_len(set_vals) {
        vec_push(vals, vec_get(set_vals, i))
        vec_push(nulls, 0)
    }
    pg_param_i64(vals, nulls, id)
    return orm_exec_params(db, sql, vals, nulls)?
}

// UPDATE by id with per-column NULL flags (set_nulls[i]==1 → SET col = NULL).
fn orm_update_by_id_full(db: OrmDb, table: str, id: i64, set_cols: Vec<str>, set_vals: Vec<str>, set_nulls: Vec<i64>) -> OrmExec !IO !Net {
    if orm_is_drock(db) == 1 {
        return kv_update_by_id(db, table, id, set_cols, set_vals, set_nulls)?
    }
    if vec_len(set_cols) != vec_len(set_vals) || vec_len(set_cols) != vec_len(set_nulls) {
        return OrmEErr(OrmExecFail { err: "orm_update_by_id_full: set_cols/set_vals/set_nulls length mismatch", tag: "", db: db })
    }
    let sql = sql_update_eq_p(table, set_cols, "id")
    let vals = vec_new()
    let nulls = vec_new()
    for i in 0..vec_len(set_vals) {
        vec_push(vals, vec_get(set_vals, i))
        vec_push(nulls, vec_get(set_nulls, i))
    }
    pg_param_i64(vals, nulls, id)
    return orm_exec_params(db, sql, vals, nulls)?
}

// Legacy lits
fn orm_update_lits(db: OrmDb, table: str, set_cols: Vec<str>, set_lits: Vec<str>, where_col: str, where_lit: str) -> OrmExec !IO !Net {
    return orm_exec(db, sql_update_eq(table, set_cols, set_lits, where_col, where_lit))?
}

// DELETE WHERE id = $1
fn orm_delete_by_id(db: OrmDb, table: str, id: i64) -> OrmExec !IO !Net {
    if orm_is_drock(db) == 1 {
        return kv_delete_by_id(db, table, id)?
    }
    let sql = sql_delete_eq_p(table, "id")
    let vals = vec_new()
    let nulls = vec_new()
    pg_param_i64(vals, nulls, id)
    return orm_exec_params(db, sql, vals, nulls)?
}

fn orm_delete_lit(db: OrmDb, table: str, col: str, lit: str) -> OrmExec !IO !Net {
    return orm_exec(db, sql_delete_eq(table, col, lit))?
}

// COUNT(*)
fn orm_count(db: OrmDb, table: str) -> OrmCount !IO !Net {
    return orm_count_sql(db, sql_count(table))?
}

// Ping: SELECT 1 (useful for /ready)
fn orm_ping(db: OrmDb) -> OrmQuery !IO !Net {
    return orm_query(db, "SELECT 1 AS n")?
}

// ---------- prepared statements (named, session-scoped) ----------

fn orm_prepare(db: OrmDb, name: str, sql: str, nparams: i64) -> OrmExec !IO !Net {
    let r = pg_prepare(db.conn, name, sql, nparams)?
    return orm_exec_from(r)
}

fn orm_exec_prepared(db: OrmDb, name: str, vals: Vec<str>, nulls: Vec<i64>) -> OrmExec !IO !Net {
    let r = pg_exec_prepared(db.conn, name, vals, nulls)?
    return orm_exec_from(r)
}

fn orm_query_prepared(db: OrmDb, name: str, vals: Vec<str>, nulls: Vec<i64>) -> OrmQuery !IO !Net {
    let r = pg_exec_prepared(db.conn, name, vals, nulls)?
    return orm_query_from(r)
}

fn orm_query_prepared_str(db: OrmDb, name: str, vals: Vec<str>) -> OrmQuery !IO !Net {
    let r = pg_exec_prepared_str(db.conn, name, vals)?
    return orm_query_from(r)
}

fn orm_deallocate(db: OrmDb, name: str) -> OrmExec !IO !Net {
    let r = pg_deallocate(db.conn, name)?
    return orm_exec_from(r)
}


fn orm_cell_i64(q: OrmQuery, row: i64, col: i64) -> i64 {
    return pg_cell_i64(orm_result(q), row, col)
}




fn orm_cell_by(q: OrmQuery, row: i64, name: str) -> str {
    let i = orm_col_index(q, name)
    if i < 0 {
        return ""
    }
    return orm_cell(q, row, i)
}

fn orm_cell_by_i64(q: OrmQuery, row: i64, name: str) -> i64 {
    let i = orm_col_index(q, name)
    if i < 0 {
        return 0
    }
    return orm_cell_i64(q, row, i)
}

// ---------- env connect helper ----------

fn orm_cfg(name: str, def: str) -> str !IO {
    let v = env(name)?
    if v == "" {
        return def
    }
    return v
}

// Defaults: bagatest @ baga_orm (see PLAN.md / password.txt in pgbaga).
fn orm_connect_env() -> OrmDb !Net !IO !Random {
    let host = orm_cfg("PGHOST", "127.0.0.1")?
    let port = parse_int(orm_cfg("PGPORT", "5432")?)
    let user = orm_cfg("PGUSER", "bagatest")?
    let password = orm_cfg("PGPASSWORD", "pas+123")?
    let database = orm_cfg("PGDATABASE", "baga_orm")?
    return orm_connect(host, port, user, password, database)?
}

// ---------- boilaDB (PG wire adapter) ----------
// Same OrmDb / CRUD / migrate surface; server is boilaDB via boilabaga.

fn orm_connect_boila(host: str, port: i64, user: str, password: str, database: str) -> OrmDb !Net !IO !Random {
    let c = boila_connect(host, port, user, password, database)?
    return orm_from_conn(c)
}

// Defaults: 127.0.0.1:6575 user=boila db=boila (see boilabaga README).
fn orm_connect_boila_env() -> OrmDb !Net !IO !Random {
    let c = boila_connect_env()?
    return orm_from_conn(c)
}

// Backend switch: ORM_BACKEND=boila|boiladb → boilabaga; else Postgres PG*.
fn orm_connect_auto_env() -> OrmDb !Net !IO !Random {
    let be = orm_cfg("ORM_BACKEND", "pg")?
    if be == "boila" || be == "boiladb" || be == "boilaDB" {
        return orm_connect_boila_env()?
    }
    return orm_connect_env()?
}

// Редовете на цялата таблица, сортирани по текстовата стойност на колона.
fn kv_select_all_order(db: OrmDb, table: str, col: str, cols: Vec<str>) -> OrmQuery !Net !IO {
    let q = kv_select_all(db, table, cols)?
    if orm_ok_q(q) == 0 {
        return q
    }
    let n = orm_nrows(q)
    if n < 2 {
        return q
    }
    let ci = orm_col_index(q, col)
    if ci < 0 {
        return q
    }
    let keys: Vec<str> = vec_new()
    let order: Vec<i64> = vec_new()
    let mut i: i64 = 0
    while i < n {
        vec_push(keys, orm_cell(q, i, ci))
        vec_push(order, i)
        i = i + 1
    }
    kv_sort_idx(keys, order)
    let ncols = vec_len(cols)
    let cells: Vec<str> = vec_new()
    let nulls: Vec<i64> = vec_new()
    let mut r: i64 = 0
    while r < n {
        let src = vec_get(order, r)
        let mut c: i64 = 0
        while c < ncols {
            vec_push(cells, orm_cell(q, src, c))
            vec_push(nulls, orm_isnull(q, src, c))
            c = c + 1
        }
        r = r + 1
    }
    return kv_query_ok(orm_db_q(q), cols, cells, nulls, n)
}


fn kv_rows_star(db: OrmDb, table: str, ids: Vec<str>) -> OrmQuery !Net !IO {
    if vec_len(ids) == 0 {
        return kv_query_empty(db, vec_new())
    }
    let keys: Vec<str> = vec_new()
    let mut i: i64 = 0
    while i < vec_len(ids) {
        vec_push(keys, kv_key_row(table, parse_int(vec_get(ids, i))))
        i = i + 1
    }
    let texts = kv_mget(db, keys)?
    let present: Vec<str> = vec_new()
    let mut j: i64 = 0
    while j < vec_len(texts) {
        if vec_get(texts, j) != "" {
            vec_push(present, vec_get(texts, j))
        }
        j = j + 1
    }
    let cols = kv_cols_of(present)
    let cells: Vec<str> = vec_new()
    let nulls: Vec<i64> = vec_new()
    let mut k: i64 = 0
    while k < vec_len(present) {
        kv_row_append(vec_get(present, k), cols, cells, nulls)
        k = k + 1
    }
    return kv_query_ok(db, cols, cells, nulls, vec_len(present))
}

fn kv_all_star(db: OrmDb, table: str) -> OrmQuery !Net !IO {
    let ids = kv_all_ids(db, table)?
    return kv_rows_star(db, table, ids)
}

fn kv_find_star(db: OrmDb, table: str, id: i64) -> OrmQuery !Net !IO {
    let text = kv_get(db, kv_key_row(table, id))?
    if text == "" {
        return kv_query_empty(db, vec_new())
    }
    let ids: Vec<str> = vec_new()
    vec_push(ids, int_to_str(id))
    return kv_rows_star(db, table, ids)
}

fn kv_where_star(db: OrmDb, table: str, col: str, val: str) -> OrmQuery !Net !IO {
    let ids = kv_ix_ids(db, table, col, val)?
    return kv_rows_star(db, table, ids)
}

fn kv_where2_star(db: OrmDb, table: str, c1: str, v1: str, c2: str, v2: str) -> OrmQuery !Net !IO {
    let a = kv_ix_ids(db, table, c1, v1)?
    let b = kv_ix_ids(db, table, c2, v2)?
    let both: Vec<str> = vec_new()
    let mut i: i64 = 0
    while i < vec_len(a) {
        if kv_ids_has(b, vec_get(a, i)) == 1 {
            vec_push(both, vec_get(a, i))
        }
        i = i + 1
    }
    return kv_rows_star(db, table, both)
}

// ── минимален SQL за KV backend-а ─────────────────────────────────────────
//
// Покрива само двете форми, които кодът ползва извън моделите: пинга
// (SELECT 1) и MAX(id)/COUNT(*) за броячи. Всичко друго връща ясна грешка —
// не тих празен резултат, за да не изглежда, че заявката е минала.
fn kv_query_sql(db: OrmDb, sql: str) -> OrmQuery !Net !IO {
    if str_find(sql, "SELECT 1") == 0 {
        let cols: Vec<str> = vec_new()
        vec_push(cols, "ok")
        let cells: Vec<str> = vec_new()
        vec_push(cells, "1")
        let nulls: Vec<i64> = vec_new()
        vec_push(nulls, 0)
        return kv_query_ok(db, cols, cells, nulls, 1)
    }
    if str_find(sql, "MAX(id)") >= 0 || str_find(sql, "COUNT(") >= 0 {
        let table = kv_sql_table(sql)
        if table == "" {
            return kv_query_err(db, "drock: не намерих таблица в SQL-а")
        }
        let mut n: i64 = 0
        if str_find(sql, "MAX(id)") >= 0 {
            let c = kv_max_id(db, table)?
            n = orm_count_n(c)
        } else {
            let c = kv_row_count(db, table)?
            n = orm_count_n(c)
        }
        let cols: Vec<str> = vec_new()
        vec_push(cols, "count")
        let cells: Vec<str> = vec_new()
        vec_push(cells, int_to_str(n))
        let nulls: Vec<i64> = vec_new()
        vec_push(nulls, 0)
        return kv_query_ok(db, cols, cells, nulls, 1)
    }
    return kv_query_err(db, concat("drock backend не изпълнява този SQL — моделът трябва да ползва kv_select_*: ", sql))
}
